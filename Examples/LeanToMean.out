def zeroOrPositive : ℕ → Prop :=
  fun (n : ℕ) => n = 0 ∨ (n ≠ 0 → n > 0)
-> MEAN
Definition:
  a natural number n is zeroOrPositive if
    n = 0 or (if n ≠ 0 then (n > 0)).

