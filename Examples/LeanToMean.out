def ordinaryPreconnected : {V : Type u_1} → SimpleGraph V → Prop :=
  fun {V : Type u_1} (G : SimpleGraph V) => ∀ (u v : V), ∃ (_p : G.Path u v), True
-> MEAN
Definition:
  a simple graph G is ordinaryPreconnected if
    for all vertices u and v of G:
      there is a path in G from u to v.

def zeroLengthLinked : {Vertex : Type u_1} → SimpleGraph Vertex → Prop :=
  fun {Vertex : Type u_1} (G : SimpleGraph Vertex) => ∀ (u v : G.V), ∃ (p : G.Path u v), (↑p : G.Walk u v).length = 0
-> MEAN
Definition:
  a simple graph G is zeroLengthLinked if
    for all vertices u and v of G:
      there is a path p in G from u to v such that
        ((↑p : G.Walk u v).length = 0).

def edgeless : {V : Type u_1} → SimpleGraph V → Prop :=
  fun {V : Type u_1} (G : SimpleGraph V) =>
    have E := G.edgeSet;
    E = ∅
-> MEAN
Definition:
  a simple graph G is edgeless if
    the edge set of G = ∅.

def zero : ℕ → Prop :=
