def boundsPairSums : ℕ → Prop :=
  fun (n : ℕ) => ∀ (x y : ℕ), x + y ≤ n
-> MEAN
Definition:
  a natural number n is boundsPairSums if
    for all natural numbers x and y:
      x + y ≤ n.

def inhabitedVertices : {V : Type u_1} → SimpleGraph V → Prop :=
  fun {V : Type u_1} (_G : SimpleGraph V) => Nonempty V
-> MEAN
Definition:
  a simple graph _G = (V, E) is inhabitedVertices if
    V is nonempty.

def emptyVertices : {V : Type u_1} → SimpleGraph V → Prop :=
  fun {V : Type u_1} (_G : SimpleGraph V) => IsEmpty V
-> MEAN
Definition:
  a simple graph _G = (V, E) is emptyVertices if
    V is empty.

