def hasNoSmallerSquare : ℝ → Prop :=
  fun (x : ℝ) => ¬∃ (y : ℝ), y * y < x
-> MEAN
Definition:
  a real number x is hasNoSmallerSquare if
    there is no real number y such that
      y * y < x.

