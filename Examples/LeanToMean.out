theorem ordinaryNatTrans3 :
  ∀ (x y z w : ℕ), x = y ∧ z = y ∧ z = w → x = w
-> MEAN
Theorem ordinaryNatTrans3:
  for all natural numbers x and y:
    for all natural numbers z and w:
      if x = y and z = y and z = w then
        x = w

