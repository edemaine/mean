def smallGraph : {V : Type} → SimpleGraph V → Prop :=
  fun {V : Type} (G : SimpleGraph V) => ∀ (u v : V), ∃ (_p : G.Path u v), True
-> MEAN
Definition:
  smallGraph is
    the function mapping an implicit element V of Type and an element G of SimpleGraph V to
      for all vertices u and v of G:
        there is a path in G from u to v.

def compoundGraph : {V : Type (max u v)} → SimpleGraph V → Prop :=
  fun {V : Type (max u v)} (G : SimpleGraph V) => ∀ (x y : V), ∃ (_p : G.Path x y), True
-> MEAN
Definition:
  compoundGraph is
    the function mapping an implicit element V of Type (max u v) and an element G of SimpleGraph V to
      for all vertices x and y of G:
        there is a path in G from x to y.

