            f T ≠ [] ∧
              Connected (f T) ∧
                (LeanWang.Abstract.TilesPlane T ↔ Tiles (f T)) ∧
                  (∀ (motions : Set (Motion d)), translations ⊆ motions → (Tiles (f T) ↔ RealTiles (f T) motions)) ∧
                    (↑(List.length (f T)) : ℝ) ≤
