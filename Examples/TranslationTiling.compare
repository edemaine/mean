-- LEAN INPUT:
abbrev TranslationTiling.Abstract.Point : Type :=
  Fin 3 → ℤ
-- MEAN OUTPUT:
Abbreviation:
  a TranslationTiling.Abstract.Point is
    a function from indices in [0, 3) to ℤ.

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.Prototile : Type :=
  List Point
-- MEAN OUTPUT:
Abbreviation:
  a TranslationTiling.Abstract.Prototile is
    a list of Point elements.

-- LEAN INPUT:
def TranslationTiling.Abstract.Adjacent : Point → Point → Prop :=
  fun (p q : Point) => ∑ i : Fin 3, |p i - q i| = 1
-- MEAN OUTPUT:
Definition:
  elements p and q of Point are TranslationTiling.Abstract.Adjacent if
    (the sum over indices i in [0, 3) of |p i - q i| = 1).

-- LEAN INPUT:
def TranslationTiling.Abstract.Connected : Prototile → Prop :=
  fun (P : Prototile) => ∀ x ∈ P, ∀ y ∈ P, Relation.ReflTransGen (fun (p q : Point) => p ∈ P ∧ q ∈ P ∧ Adjacent p q) x y
-- MEAN OUTPUT:
Definition:
  an element P of Prototile is TranslationTiling.Abstract.Connected if
    for every x ∈ P:
      for every y ∈ P:
        x is related to y by the reflexive transitive closure of
          (the function mapping an element p of Point and an element q of Point to
              p ∈ P and q ∈ P and (p and q are Adjacent)).

-- LEAN INPUT:
def TranslationTiling.Abstract.Tiles : Prototile → Prop :=
  fun (P : Prototile) => ∃ (T : Set Point), ∀ (x : Point), ∃! t : Point, t ∈ T ∧ x - t ∈ P
-- MEAN OUTPUT:
Definition:
  an element P of Prototile is TranslationTiling.Abstract.Tiles if
    there is a set T of Point elements such that
      for every element x of Point:
        there is a unique element t of Point such that
          t ∈ T and x - t ∈ P.

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_coRE_complete :
  LeanWang.Abstract.CoREComplete fun (P : Prototile) => Connected P ∧ Tiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_coRE_complete:
  (the function mapping an element P of Prototile to
    P is Connected and P is Tiles) is LeanWang.Abstract.CoREComplete

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_undecidable :
  ¬ComputablePred fun (P : Prototile) => Connected P ∧ Tiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_undecidable:
  (the function mapping an element P of Prototile to
    P is Connected and P is Tiles) is not computable

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_simulates_wang :
  ∀ (T : List LeanWang.Abstract.Tile),
    ∃ (P : Prototile),
      P ≠ [] ∧
        Connected P ∧
          (LeanWang.Abstract.TilesPlane T ↔ Tiles P) ∧
            (↑(List.length P) : ℝ) ≤ ((↑T.length : ℝ) + 4) ^ (10 ^ 61 * Real.logb 2 (Real.logb 2 ((↑T.length : ℝ) + 4)))
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_simulates_wang:
  for every list T of LeanWang.Abstract.Tile elements:
    there is an element P of Prototile such that
      P ≠ [] and
      P is Connected and
      (T is LeanWang.Abstract.TilesPlane if and only if P is Tiles) and
      List.length P as a real number ≤
        (T.length as a real number + 4) ^ (10 ^ 61 * Real.logb 2 (Real.logb 2 (T.length as a real number + 4)))

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.RealPoint : Type :=
  Fin 3 → ℝ
-- MEAN OUTPUT:
Abbreviation:
  a TranslationTiling.Abstract.RealPoint is
    a function from indices in [0, 3) to ℝ.

-- LEAN INPUT:
def TranslationTiling.Abstract.Solid : Prototile → Set RealPoint :=
  fun (P : Prototile) => {x : RealPoint | ∃ p ∈ P, ∀ (i : Fin 3), (↑(p i) : ℝ) ≤ x i ∧ x i ≤ (↑(p i) : ℝ) + 1}
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.Solid is
    the function mapping an element P of Prototile to
      the set of elements x of RealPoint such that
        there is an element p of Point such that
          p ∈ P and
          (for every index i in [0, 3):
            p i as a real number ≤ x i and x i ≤ p i as a real number + 1).

-- LEAN INPUT:
def TranslationTiling.Abstract.RealTiles : Prototile → Prop :=
  fun (P : Prototile) => ∃ (T : Set RealPoint), ∀ᵐ (x : RealPoint), ∃! t : RealPoint, t ∈ T ∧ x - t ∈ Solid P
-- MEAN OUTPUT:
Definition:
  an element P of Prototile is TranslationTiling.Abstract.RealTiles if
    there is a set T of RealPoint elements such that
      for almost every element x of RealPoint:
        there is a unique element t of RealPoint such that
          t ∈ T and x - t ∈ Solid P.

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_coRE_complete :
  LeanWang.Abstract.CoREComplete fun (P : Prototile) => Connected P ∧ RealTiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_coRE_complete:
  (the function mapping an element P of Prototile to
    P is Connected and P is RealTiles) is LeanWang.Abstract.CoREComplete

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_undecidable :
  ¬ComputablePred fun (P : Prototile) => Connected P ∧ RealTiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_undecidable:
  (the function mapping an element P of Prototile to
    P is Connected and P is RealTiles) is not computable

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_simulates_wang :
  ∀ (T : List LeanWang.Abstract.Tile),
    ∃ (P : Prototile),
      P ≠ [] ∧
        Connected P ∧
          (LeanWang.Abstract.TilesPlane T ↔ RealTiles P) ∧
            (↑(List.length P) : ℝ) ≤ ((↑T.length : ℝ) + 4) ^ (10 ^ 61 * Real.logb 2 (Real.logb 2 ((↑T.length : ℝ) + 4)))
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_simulates_wang:
  for every list T of LeanWang.Abstract.Tile elements:
    there is an element P of Prototile such that
      P ≠ [] and
      P is Connected and
      (T is LeanWang.Abstract.TilesPlane if and only if P is RealTiles) and
