-- LEAN INPUT:
def LeanWang.Abstract.CoREHard : {α : Type u_1} → [Primcodable α] → (α → Prop) → Prop :=
  fun {α : Type u_1} [Primcodable α] (p : α → Prop) =>
    ∀ (q : ℕ → Prop), CoRE q → ∃ (r : ℕ → α), Computable r ∧ ∀ (n : ℕ), q n ↔ p (r n)
-- MEAN OUTPUT:
Definition:
  LeanWang.Abstract.CoREHard is
    the function mapping an implicit element α of Type u_1 and an instance of typeclass Primcodable α and a function p from α to Prop to
      for every function q from ℕ to Prop satisfying CoRE:
        there is a function r from ℕ to α such that
          r is computable and
          for every natural number n:
            n satisfies q if and only if (r n) satisfies p.

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.Point : ℕ → Type :=
  fun (d : ℕ) => Fin d → ℤ
-- MEAN OUTPUT:
Abbreviation:
  TranslationTiling.Abstract.Point is
    the function mapping a natural number d to
      the type of functions from indices in [0, d) to ℤ.

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.Prototile : ℕ → Type :=
  fun (d : ℕ) => List (Point d)
-- MEAN OUTPUT:
Abbreviation:
  TranslationTiling.Abstract.Prototile is
    the function mapping a natural number d to
      the type of lists of (Point d) elements.

-- LEAN INPUT:
def TranslationTiling.Abstract.Adjacent : {d : ℕ} → Point d → Point d → Prop :=
  fun {d : ℕ} (p q : Point d) => ∑ i : Fin d, |p i - q i| = 1
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.Adjacent is
    (the function mapping an implicit natural number d and an element p of Point d and an element q of Point d to
      the sum over indices i in [0, d) of |p i - q i| = 1).

-- LEAN INPUT:
def TranslationTiling.Abstract.Connected : {d : ℕ} → Prototile d → Prop :=
  fun {d : ℕ} (P : Prototile d) =>
    ∀ x ∈ P, ∀ y ∈ P, Relation.ReflTransGen (fun (p q : Point d) => p ∈ P ∧ q ∈ P ∧ Adjacent p q) x y
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.Connected is
    the function mapping an implicit natural number d and an element P of Prototile d to
      for every x ∈ P:
        for every y ∈ P:
          x is related to y by the reflexive transitive closure of
            (the function mapping an element p of Point d and an element q of Point d to
                p ∈ P and q ∈ P and (p and q satisfy Adjacent)).

-- LEAN INPUT:
def TranslationTiling.Abstract.Tiles : {d : ℕ} → Prototile d → Prop :=
  fun {d : ℕ} (P : Prototile d) => ∃ (T : Set (Point d)), ∀ (x : Point d), ∃! t : Point d, t ∈ T ∧ x - t ∈ P
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.Tiles is
    the function mapping an implicit natural number d and an element P of Prototile d to
      there is a set T of Point d elements such that
        for every element x of Point d:
          there is exactly one t ∈ T such that
            x - t ∈ P.

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_coRE_complete :
  ∀ (d : ℕ), 3 ≤ d → LeanWang.Abstract.CoREComplete fun (P : Prototile d) => Connected P ∧ Tiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_coRE_complete:
  for every natural number d where 3 ≤ d:
    (the function mapping an element P of Prototile d to
      P satisfies Connected and P satisfies Tiles) satisfies LeanWang.Abstract.CoREComplete

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_undecidable :
  ∀ (d : ℕ), 3 ≤ d → ¬ComputablePred fun (P : Prototile d) => Connected P ∧ Tiles P
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_undecidable:
  for every natural number d where 3 ≤ d:
    (the function mapping an element P of Prototile d to
      P satisfies Connected and P satisfies Tiles) is not computable

-- LEAN INPUT:
theorem TranslationTiling.Abstract.tiling_reduction :
  ∀ (d : ℕ),
    3 ≤ d →
      ∃ (f : List LeanWang.Abstract.Tile → Prototile d),
        Computable f ∧
          ∀ (T : List LeanWang.Abstract.Tile),
            f T ≠ [] ∧
              Connected (f T) ∧
                (LeanWang.Abstract.TilesPlane T ↔ Tiles (f T)) ∧
                  (↑(List.length (f T)) : ℝ) ≤
                    ((↑T.length : ℝ) + 4) ^ (10 ^ 61 * Real.logb 2 (Real.logb 2 ((↑T.length : ℝ) + 4)))
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.tiling_reduction:
  for every natural number d where 3 ≤ d:
    there is a function f from lists of LeanWang.Abstract.Tile elements to Prototile d such that
      f is computable and
      for every list T of LeanWang.Abstract.Tile elements:
        (f T) is a nonempty list and
        (f T) satisfies Connected and
        (T satisfies LeanWang.Abstract.TilesPlane if and only if (f T) satisfies Tiles) and
        the length of (f T) as a real number ≤
          (the length of T as a real number + 4) ^
            (10 ^ 61 * log base 2 of (log base 2 of (the length of T as a real number + 4)))

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.RealPoint : ℕ → Type :=
  fun (d : ℕ) => EuclideanSpace ℝ (Fin d)
-- MEAN OUTPUT:
Abbreviation:
  TranslationTiling.Abstract.RealPoint is
    the function mapping a natural number d to
      the real Euclidean space of dimension d.

-- LEAN INPUT:
def TranslationTiling.Abstract.Solid : {d : ℕ} → Prototile d → Set (RealPoint d) :=
  fun {d : ℕ} (P : Prototile d) =>
    {x : RealPoint d |
      ∃ p ∈ P,
        ∀ (i : Fin d),
          (↑(p i) : (fun (x : Fin d) => ℝ) i) ≤ x.ofLp i ∧ x.ofLp i ≤ (↑(p i) : (fun (x : Fin d) => ℝ) i) + 1}
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.Solid is
    (the function mapping an implicit natural number d and an element P of Prototile d to
      the set of elements x of RealPoint d such that
        there is p ∈ P such that
          for every index i in [0, d):
            p i as a real number ≤ x i and x i ≤ p i as a real number + 1).

-- LEAN INPUT:
abbrev TranslationTiling.Abstract.Motion : ℕ → Type :=
  fun (d : ℕ) => RealPoint d ≃ᵃⁱ[ℝ] RealPoint d
-- MEAN OUTPUT:
Abbreviation:
  TranslationTiling.Abstract.Motion is
    the function mapping a natural number d to
      the type of bijective affine isometries from (RealPoint d) to (RealPoint d) over ℝ.

-- LEAN INPUT:
def TranslationTiling.Abstract.allMotions : {d : ℕ} → Set (Motion d) :=
  fun {d : ℕ} => Set.univ
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.allMotions is
    the function mapping an implicit natural number d to
      the set of all elements of (Motion d).

-- LEAN INPUT:
def TranslationTiling.Abstract.translations : {d : ℕ} → Set (Motion d) :=
  fun {d : ℕ} => {f : Motion d | f.linear = 1}
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.translations is
    (the function mapping an implicit natural number d to
      the set of elements f of Motion d such that
        the linear part of f = 1).

-- LEAN INPUT:
def TranslationTiling.Abstract.translationsAndRotations : {d : ℕ} → Set (Motion d) :=
  fun {d : ℕ} => {f : Motion d | (LinearEquiv.det : (RealPoint d ≃ₗ[ℝ] RealPoint d) → ℝˣ) f.linear = 1}
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.translationsAndRotations is
    (the function mapping an implicit natural number d to
      the set of elements f of Motion d such that
        the determinant of (the linear part of f) = 1).

-- LEAN INPUT:
def TranslationTiling.Abstract.translationsAndReflections : {d : ℕ} → Set (Motion d) :=
  fun {d : ℕ} =>
    {f : Motion d |
      ∃ t ∈ translations,
        ∃ (p : RealPoint d) (q : RealPoint d), f = t * EuclideanGeometry.reflection (AffineSubspace.perpBisector p q)}
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.translationsAndReflections is
    the function mapping an implicit natural number d to
      the set of elements f of Motion d such that
        there is t ∈ translations such that
          there is an element p of RealPoint d such that
            there is an element q of RealPoint d such that
              f = t * the reflection across (the perpendicular bisector of p and q).

-- LEAN INPUT:
def TranslationTiling.Abstract.RealTiles : {d : ℕ} → Prototile d → Set (Motion d) → Prop :=
  fun {d : ℕ} (P : Prototile d) (motions : Set (Motion d)) =>
    ∃ T ⊆ motions, ∀ᵐ (x : RealPoint d), ∃! f : Motion d, f ∈ T ∧ x ∈ (⇑f : RealPoint d → RealPoint d) '' Solid P
-- MEAN OUTPUT:
Definition:
  TranslationTiling.Abstract.RealTiles is
    the function mapping an implicit natural number d and an element P of Prototile d and a set motions of Motion d elements to
      there is a subset T of motions such that
        for almost every element x of RealPoint d:
          there is exactly one f ∈ T such that
            x ∈ the image of (Solid P) under f.

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_coRE_hard :
  ∀ (d : ℕ),
    3 ≤ d →
      ∀ (motions : Set (Motion d)),
        translations ⊆ motions → LeanWang.Abstract.CoREHard fun (P : Prototile d) => Connected P ∧ RealTiles P motions
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_coRE_hard:
  for every natural number d where 3 ≤ d:
    for every superset motions of translations:
      (the function mapping an element P of Prototile d to
        P satisfies Connected and (P and motions satisfy RealTiles)) satisfies LeanWang.Abstract.CoREHard

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_undecidable :
  ∀ (d : ℕ),
    3 ≤ d →
      ∀ (motions : Set (Motion d)),
        translations ⊆ motions → ¬ComputablePred fun (P : Prototile d) => Connected P ∧ RealTiles P motions
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_undecidable:
  for every natural number d where 3 ≤ d:
    for every superset motions of translations:
      (the function mapping an element P of Prototile d to
        P satisfies Connected and (P and motions satisfy RealTiles)) is not computable

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_coRE_complete :
  ∀ (d : ℕ),
    3 ≤ d →
      ∀ motions ∈ {allMotions, translations, translationsAndRotations, translationsAndReflections},
        LeanWang.Abstract.CoREComplete fun (P : Prototile d) => Connected P ∧ RealTiles P motions
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_coRE_complete:
  for every natural number d where 3 ≤ d:
    for every motions ∈ the set {allMotions, translations, translationsAndRotations, translationsAndReflections}:
      (the function mapping an element P of Prototile d to
        P satisfies Connected and (P and motions satisfy RealTiles)) satisfies LeanWang.Abstract.CoREComplete

-- LEAN INPUT:
theorem TranslationTiling.Abstract.real_tiling_reduction :
  ∀ (d : ℕ),
    3 ≤ d →
      ∃ (f : List LeanWang.Abstract.Tile → Prototile d),
        Computable f ∧
          ∀ (T : List LeanWang.Abstract.Tile),
            f T ≠ [] ∧
              Connected (f T) ∧
                (LeanWang.Abstract.TilesPlane T ↔ Tiles (f T)) ∧
                  (Tiles (f T) ↔ RealTiles (f T) translations) ∧
                    (↑(List.length (f T)) : ℝ) ≤
                      ((↑T.length : ℝ) + 4) ^ (10 ^ 61 * Real.logb 2 (Real.logb 2 ((↑T.length : ℝ) + 4)))
-- MEAN OUTPUT:
Theorem TranslationTiling.Abstract.real_tiling_reduction:
  for every natural number d where 3 ≤ d:
    there is a function f from lists of LeanWang.Abstract.Tile elements to Prototile d such that
      f is computable and
      for every list T of LeanWang.Abstract.Tile elements:
        (f T) is a nonempty list and
        (f T) satisfies Connected and
        (T satisfies LeanWang.Abstract.TilesPlane if and only if (f T) satisfies Tiles) and
        ((f T) satisfies Tiles if and only if (f T) and translations satisfy RealTiles) and
        the length of (f T) as a real number ≤
          (the length of T as a real number + 4) ^
            (10 ^ 61 * log base 2 of (log base 2 of (the length of T as a real number + 4)))

