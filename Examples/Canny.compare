-- LEAN INPUT:
/-- Integer polynomial expressions use constants, variables, addition, and
multiplication. In dimension `n`, variables are the indices `Fin n`. -/
inductive Term (n : ℕ) where
  | const : ℤ → Term n
  | var : Fin n → Term n
  | add : Term n → Term n → Term n
  | mul : Term n → Term n → Term n
-- MEAN OUTPUT:
Inductive type Term parameterized by a natural number n
with constructors:
  const from an integer;
  var from an index in [0, n);
  add from two elements of Term n;
  mul from two elements of Term n.

-- LEAN INPUT:
/-- Evaluate an integer polynomial expression at a real assignment `x`. -/
def Term.eval {n : ℕ} (x : Fin n → ℝ) : Term n → ℝ
  | .const z => z
  | .var i => x i
  | .add p q => p.eval x + q.eval x
  | .mul p q => p.eval x * q.eval x
-- MEAN OUTPUT:
Definition:
  Term.eval maps an implicit natural number n and a function x from indices in [0, n) to ℝ and an element t of Term n
    to a real number
    by cases on t:
      const z gives z;
      var i gives x i;
      add p q gives p.eval x + q.eval x;
      mul p q gives p.eval x * q.eval x.

-- LEAN INPUT:
/-- A Boolean formula compares polynomial expressions with zero, using equality
or strict inequality, and combines these assertions by negation, conjunction,
and disjunction. ETR existentially quantifies all occurring variables;
connectivity treats them as coordinates of the described space. -/
inductive Formula (n : ℕ) where
  | false : Formula n
  | eqZero : Term n → Formula n
  | ltZero : Term n → Formula n
  | not : Formula n → Formula n
  | and : Formula n → Formula n → Formula n
  | or : Formula n → Formula n → Formula n
-- MEAN OUTPUT:
Inductive type Formula parameterized by a natural number n
with constructors:
  false;
  eqZero from an element of Term n;
  ltZero from an element of Term n;
  «not» from an element of Formula n;
  «and» from two elements of Formula n;
  «or» from two elements of Formula n.

-- LEAN INPUT:
/-- A formula describes a solution set in `ℝⁿ`, represented by `Fin n → ℝ`.
Negation, conjunction, and disjunction give complement, intersection, and union. -/
def Formula.solutionSet {n : ℕ} : Formula n → Set (Fin n → ℝ)
  | .false => ∅
  | .eqZero t => {x | t.eval x = 0}
  | .ltZero t => {x | t.eval x < 0}
  | .not p => p.solutionSetᶜ
  | .and p q => p.solutionSet ∩ q.solutionSet
  | .or p q => p.solutionSet ∪ q.solutionSet
-- MEAN OUTPUT:
Definition:
  Formula.solutionSet maps an implicit natural number n and an element t of Formula n
    to a set of functions from indices in [0, n) to ℝ
    by cases on t:
      false gives ∅;
      eqZero t gives the set of functions x from indices in [0, n) to ℝ such that
        t.eval x = 0;
      ltZero t gives the set of functions x from indices in [0, n) to ℝ such that
        t.eval x < 0;
      «not» p gives the complement of p.solutionSet;
      «and» p q gives p.solutionSet ∩ q.solutionSet;
      «or» p q gives p.solutionSet ∪ q.solutionSet.

-- LEAN INPUT:
/-- Intended: unary dimension encoding.

These declarations stand in for CSLib Frontier. The encoding interfaces are
