-- MEAN INPUT:
Definition:
  a simple graph G is hasNoEdges if the edge set of G = ∅.
-- LEAN OUTPUT:
def hasNoEdges.{u_1} : {Vertex : Type u_1} → (G : SimpleGraph Vertex) → Prop :=
  fun {Vertex : Type u_1} (G : SimpleGraph Vertex) => G.edgeSet = ∅

-- MEAN INPUT:
Definition:
  a simple graph G is hasNoEdgesPossessive if G's edge set = ∅.
-- LEAN OUTPUT:
def hasNoEdgesPossessive.{u_1} : {Vertex : Type u_1} → (G : SimpleGraph Vertex) → Prop :=
  fun {Vertex : Type u_1} (G : SimpleGraph Vertex) => G.edgeSet = ∅

