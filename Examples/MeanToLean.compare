-- MEAN INPUT:
Definition:
  an element f of (Nat → Nat) is oneToOne if f is injective.
-- LEAN OUTPUT:
def oneToOne : (f : ℕ → ℕ) → Prop :=
  fun (f : ℕ → ℕ) => Function.Injective f

