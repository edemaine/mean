-- MEAN INPUT:
Definition:
  twice maps a natural number n to a natural number
  by cases on n:
    zero gives 0;
    succ k gives (twice k + 2).
-- LEAN OUTPUT:
def twice : (n : ℕ) → ℕ :=
  fun (n : ℕ) => Nat.brecOn n twice._f

-- MEAN INPUT:
Definition:
  flip maps a boolean b to a boolean by cases on b:
    false gives true;
    true gives false.
-- LEAN OUTPUT:
def flip : (b : Bool) → Bool :=
  fun (b : Bool) =>
    match b with
    | false => true
    | true => false

-- MEAN INPUT:
Abbreviation:
  bitValue maps a boolean b to a natural number by cases on b:
    false gives 0;
    true gives (1).
-- LEAN OUTPUT:
abbrev bitValue : (b : Bool) → ℕ :=
  fun (b : Bool) =>
    match b with
    | false => 0
    | true => 1

-- MEAN INPUT:
Definition:
  choosePair maps a boolean b to an element of Nat × Nat by cases on b:
    false gives (0, 0);
    true gives (1, 1).
-- LEAN OUTPUT:
def choosePair : (b : Bool) → ℕ × ℕ :=
  fun (b : Bool) =>
    match b with
    | false => (0, 0)
    | true => (1, 1)

