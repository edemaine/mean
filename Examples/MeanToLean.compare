Theorem natTrans3:
  for all natural numbers x and y:
    for all natural numbers z and w:
      if x = y and z = y and z = w then x = w
Proof: by
  intro x y z w ⟨hxy, hzy, hzw⟩
  exact hxy.trans (hzy.symm.trans hzw)
-- LEAN OUTPUT:
theorem natTrans3 : ∀ (x y z w : ℕ), x = y ∧ z = y ∧ z = w → x = w :=
  fun (x y z w : ℕ) (h : x = y ∧ z = y ∧ z = w) =>
    match h with
    | ⟨hxy, ⟨hzy, hzw⟩⟩ => Eq.trans hxy (Eq.trans (Eq.symm hzy) hzw)

