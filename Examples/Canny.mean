Inductive type Term parameterized by a natural number n
with constructors:
  const from an integer;
  var from an index in [0, n);
  add from two elements of Term n;
  mul from two elements of Term n.

Definition:
  Term.eval maps an implicit natural number n and a function x from indices in [0, n) to ℝ and an element t of Term n
    to a real number
    by cases on t:
      const z gives z;
      var i gives x i;
      add p q gives p.eval x + q.eval x;
      mul p q gives p.eval x * q.eval x.

Inductive type Formula parameterized by a natural number n
with constructors:
  false;
  eqZero from an element of Term n;
  ltZero from an element of Term n;
  «not» from an element of Formula n;
  «and» from two elements of Formula n;
  «or» from two elements of Formula n.

Definition:
  Formula.solutionSet maps an implicit natural number n and an element t of Formula n
    to a set of functions from indices in [0, n) to ℝ
    by cases on t:
      false gives ∅;
      eqZero t gives the set of functions x from indices in [0, n) to ℝ such that
        t.eval x = 0;
      ltZero t gives the set of functions x from indices in [0, n) to ℝ such that
        t.eval x < 0;
      «not» p gives the complement of p.solutionSet;
      «and» p q gives p.solutionSet ∩ q.solutionSet;
      «or» p q gives p.solutionSet ∪ q.solutionSet.

Axiom encTerm:
  for every natural number n:
    we have an injective function from Term n to lists of booleans

Axiom encFormula:
  for every natural number n:
    we have an injective function from Formula n to lists of booleans

Definition:
  ETR is
    the union over natural numbers n of
        the image of
          (the set of elements p of Formula n such that
              p.solutionSet satisfies Set.Nonempty)
          under (encFormula n).

Theorem etr_in_PSPACE:
  ETR ∈ Background.PSPACE Background.encBits

Theorem etr_in_CountingLevel:
  ETR ∈ Background.CountingLevel 26 Background.encBits

Definition:
  ExistsReal is
    the set of elements L of the type of sets of (the type of lists of booleans) elements such that
      Background.encBits and Background.encBits and L and ETR satisfy Background.PolyTimeReducible.

Theorem existsReal_subset_PSPACE:
  ExistsReal ⊆ Background.PSPACE Background.encBits

Theorem existsReal_subset_CountingLevel:
  ExistsReal ⊆ Background.CountingLevel 26 Background.encBits

Definition:
  Formula.existsForallSolutionSet is
    the function mapping an implicit natural number r and an implicit natural number s and an element p of Formula (r + s) to
      the set of functions x from indices in [0, r) to ℝ such that
        for every function y from indices in [0, s) to ℝ:
          (the function mapping an index i in [0, r + s) to
                Fin.addCases x y i) ∈
            p.solutionSet.

Definition:
  ExistsForallReal is
    the union over natural numbers r and s of
        the image of
          (the set of elements p of Formula (r + s) such that
              p.existsForallSolutionSet satisfies Set.Nonempty)
          under
          (the function mapping an element p of Formula (r + s) to
              (Background.encPair Background.encUnary Background.encBits :
                  ℕ × the type of lists of booleans → the type of lists of booleans)
                (r, (encFormula (r + s) : Formula (r + s) → the type of lists of booleans) p)).

Theorem existsForallReal_in_CountingLevel:
  ExistsForallReal ∈ Background.CountingLevel 60 Background.encBits

Definition:
  ConnectedFormulas is
    the function mapping a natural number n to
      the set of elements p of Formula n such that
        p.solutionSet satisfies IsPreconnected.

Definition:
  ConnectedLanguage is
    the union over natural numbers n of
        the image of (ConnectedFormulas n) under
          (the function mapping an element p of Formula n to
              (Background.encPair Background.encUnary Background.encBits :
                  ℕ × the type of lists of booleans → the type of lists of booleans)
                (n, (encFormula n : Formula n → the type of lists of booleans) p)).

Theorem connectedLanguage_in_PSPACE:
  ConnectedLanguage ∈ Background.PSPACE Background.encBits

Definition:
  ReachableEndpoints is
    the function mapping an implicit natural number n and an element p of Formula n to
      the set of elements x of Formula n × Formula n such that
        match x with
        | (p₁, p₂) =>
          ∃ (x : the type of indices in [0, n) → ℝ) (y : the type of indices in [0, n) → ℝ),
            p₁.solutionSet = the set {x} ∧
              p₂.solutionSet = the set {y} ∧
                ∃ (γ : Path x y),
                  ∀ (t : unitInterval as Type), (γ : unitInterval as Type → the type of indices in [0, n) → ℝ) t ∈ p.solutionSet.

Definition:
  ReachableLanguage is
    the union over natural numbers n of
        the union over elements p of (Formula n) of
            the image of (ReachableEndpoints p) under
              (the function mapping an element x of Formula n × Formula n to
                  match x with
                  | (p₁, p₂) =>
                    (Background.encPair Background.encUnary (Background.encList Background.encBits) :
                        ℕ × the type of lists of (the type of lists of booleans) elements → the type of lists of booleans)
                      (n,
                        [(encFormula n : Formula n → the type of lists of booleans) p,
                          (encFormula n : Formula n → the type of lists of booleans) p₁,
                          (encFormula n : Formula n → the type of lists of booleans) p₂])).

Theorem reachableLanguage_in_PSPACE:
  ReachableLanguage ∈ Background.PSPACE Background.encBits
